# Build trees. Repo-root anchored on purpose: an unanchored "build/" pattern also
# matches third_party/JUCE/extras/Build/ and would silently exclude vendored JUCE
# CMake support files (verified: it did).
/build/
/build-*/
/out/
Testing/
CMakeLists.txt.user
# CI FetchContent download cache (pinned Catch2/nlohmann sources; see
# .github/workflows/ci.yml) - machine state, never repo state.
/.fc-cache/

# IDE / tooling
.vs/
.vscode/
.idea/
.cache/
*.user
*.suo
.opencode/
# Generated by Visual Studio when the folder is opened. Its default buildRoot puts a
# build tree inside the repository, which conflicts with the documented out-of-tree
# build trees, so it stays machine-local and is not tracked.
/CMakeSettings.json

# Compiler and linker artifacts (any depth)
*.obj
*.pdb
*.ilk
*.exp
*.iobj
*.ipdb
*.suo
*.sbr
compile_commands.json

# Secrets and local state (the project rules: never commit a credential)
.env
.env.*
!.env.example
*.log
logs/
config.local.json
secrets/
credentials/

# Generated JUCE output inside a source tree, if anyone builds in-tree
JUCE-build/
juce-source/

# Never ignore vendored dependencies
!/third_party/
